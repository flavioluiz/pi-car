#!/usr/bin/env bash
# Auto-bump patch version on every commit.
# Skipped during rebase/merge/cherry-pick, or if VERSION is already staged
# (e.g. after a manual `scripts/bump.sh minor`).
set -euo pipefail

git_dir=$(git rev-parse --git-dir)
for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  [[ -e "$git_dir/$state" ]] && exit 0
done

if ! git diff --cached --quiet -- VERSION 2>/dev/null; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
"$root/scripts/bump.sh" patch >/dev/null
git add "$root/VERSION" "$root/README.md"
